[Unit]
Description=AI VaultIO Remote Agent
Documentation=https://github.com/sandboxcsp/ai-vault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiv_agent
Group=aiv_agent
ExecStart=/usr/local/bin/aiv_agent \
    --port 9090 \
    --cert /etc/aiv_agent/server.crt \
    --key /etc/aiv_agent/server.key \
    --ca /etc/aiv_agent/ca.crt
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/
ReadWritePaths=/tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
