platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # ── Rust / LanceDB build phase ─────────────────────────────────────────────
  # Compile the Rust crate and embed the dylib in the macOS app bundle.
  # Added once to Runner.xcodeproj; subsequent pod installs are no-ops.
  require 'xcodeproj'
  project_path = File.expand_path('Runner.xcodeproj', __dir__)
  project = Xcodeproj::Project.open(project_path)

  runner = project.targets.find { |t| t.name == 'Runner' }
  phase_name = 'Build & Embed Rust (LanceDB)'

  unless runner.shell_script_build_phases.any? { |p| p.name == phase_name }
    phase = runner.new_shell_script_build_phase(phase_name)
    # SRCROOT = macos/ directory; .. goes to the Flutter project root.
    # cargo build (no --target) outputs to rust/target/release/, matching
    # FRB's kDefaultExternalLibraryLoaderConfig ioDirectory.
    phase.shell_script = <<~'BASH'
      set -e
      export PATH="$HOME/.cargo/bin:$PATH"
      REPO_ROOT="$SRCROOT/.."
      CARGO_MANIFEST="$REPO_ROOT/rust/Cargo.toml"

      # Always build in release mode.
      # FRB's ioDirectory (for flutter run) points to rust/target/release/,
      # so we always produce a release dylib regardless of Flutter build config.
      cargo build --release --manifest-path "$CARGO_MANIFEST"
      RUST_LIB="$REPO_ROOT/rust/target/release/libai_vault_rust.dylib"

      DEST="$BUILT_PRODUCTS_DIR/$FRAMEWORKS_FOLDER_PATH/libai_vault_rust.dylib"
      cp "$RUST_LIB" "$DEST"
      install_name_tool -id "@rpath/libai_vault_rust.dylib" "$DEST"
    BASH
    runner.build_phases.move(phase, 0)
    project.save
  end
end
